# ========== DISCORD (lo más fácil) ==========
# Crea un Webhook en tu servidor de Discord y pega aquí la URL.
# Cómo: Canal → Editar canal → Integraciones → Webhooks → Nuevo webhook → Copiar URL
DISCORD_WEBHOOK_URL=

# ========== X / TWITTER (opcional) ==========
# Solo si también quieres que publique en X.
# Necesitas una App de desarrollador en developer.x.com
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# true = solo prueba, no publica ni guarda
DRY_RUN=false

# es | en
POST_LANGUAGE=es
